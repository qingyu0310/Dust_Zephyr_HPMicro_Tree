+static void uart_hpm_rx_timeout_work_handler(struct k_work *work)
+{
+	struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+	struct uart_hpm_data *data = CONTAINER_OF(dwork, struct uart_hpm_data, rx_timeout_work);
+	const struct device *dev = data->dma_rxinfo.dev;
+#if UART_HPM_USE_HW_RX_IDLE
+	if (!data->rx_timeout_work_enabled || data->rx_idle_work_busy ||
+	    (dev == NULL) || (data->dma_rxinfo.current_mode == 0U)) {
+		return;
+	}
+
+	if (!data->rx_idle_irq_pending) {
+		return;
+	}
+
+	data->rx_idle_irq_pending = false;
+	data->rx_idle_work_busy = true;
+	uart_hpm_hw_rx_idle_handler(dev);
+	if (data->rx_idle_timer_enabled) {
+		config_gptmr_to_poll_uart_rx_idle(&data->gptmr_info, data->rx_idle_poll_us);
+	}
+	data->rx_idle_work_busy = false;
+#else
+	const struct uart_hpm_cfg *config;
+	UART_Type *uart_base;
+	struct dma_status stat;
+	size_t pending;
+	size_t rx_remaining;
+	int ret;
+
+	if (!data->rx_timeout_work_enabled || data->rx_idle_work_busy ||
+	    (dev == NULL) || (data->dma_rxinfo.current_mode == 0U)) {
+		return;
+	}
+
+	config = dev->config;
+	uart_base = config->base;
+
+	ret = dma_get_status(data->dma_rx.dma_dev, data->dma_rx.channel, &stat);
+	if (ret != 0) {
+		goto reschedule;
+	}
+
+	pending = stat.pending_length;
+	if (pending != data->rx_last_pending_length) {
+		data->rx_last_pending_length = pending;
+		goto reschedule;
+	}
+
+	if (data->dma_rxinfo.current_offset > data->dma_rxinfo.current_total_size) {
+		goto reschedule;
+	}
+
+	rx_remaining = data->dma_rxinfo.current_total_size - data->dma_rxinfo.current_offset;
+	if (pending >= rx_remaining) {
+		goto reschedule;
+	}
+
+	if (dma_suspend(data->dma_rx.dma_dev, data->dma_rx.channel) == 0) {
+		uart_hpm_async_rx_flush(dev);
+		if ((data->dma_rxinfo.current_size > 0U) && (data->dma_rxinfo.next_dst_addr != NULL)) {
+			async_evt_rx_buf_release(dev);
+			if (uart_hpm_dma_replace_rx_buffer(dev) == 0) {
+				return;
+			}
+		} else {
+			(void)dma_resume(data->dma_rx.dma_dev, data->dma_rx.channel);
+		}
+	}
+
+reschedule:
+	if (data->rx_timeout_work_enabled && (data->rx_idle_poll_us > 0U)) {
+		k_work_reschedule(&data->rx_timeout_work, K_USEC(data->rx_idle_poll_us));
+	}
+#endif
+}
