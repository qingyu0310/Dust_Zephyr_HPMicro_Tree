+	gptmr_channel_reset_count(gptmr_info->ptr, gptmr_info->cmp_ch);
+	gptmr_channel_config(gptmr_info->ptr, gptmr_info->cmp_ch, &config, false);
+	gptmr_enable_irq(gptmr_info->ptr, GPTMR_CH_RLD_IRQ_MASK(gptmr_info->cmp_ch));
