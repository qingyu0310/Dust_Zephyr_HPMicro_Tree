+static void udc_hpm_dump_regs(usb_device_handle_t *handle, const char *tag)
+{
+	uint32_t portsc = handle->regs->PORTSC1;
+	uint32_t otgsc = handle->regs->OTGSC;
+	uint32_t phy_status = handle->regs->PHY_STATUS;
+
+	USB_HPM_TRACE_PRINTK("usb:%s USBCMD=0x%x USBSTS=0x%x USBINTR=0x%x USBMODE=0x%x PORTSC=0x%x ccs=%u csc=%u pe=%u pec=%u pr=%u susp=%u ls=%u pfsc=%u pspd=%u OTGSC=0x%x otg_asv=%u otg_avv=%u otg_id=%u otg_idpu=%u otg_vc=%u otg_vd=%u DEVADDR=0x%x ENDPTLIST=0x%x SETUP=0x%x PRIME=0x%x FLUSH=0x%x STAT=0x%x COMPLETE=0x%x CTRL0=0x%x OTG_CTRL0=0x%x PHY_STATUS=0x%x phy_clk=%u phy_ls=%u phy_disc=%u phy_id=%u phy_sess=%u phy_vbus=%u\n",
+	       tag,
+	       handle->regs->USBCMD,
+	       handle->regs->USBSTS,
+	       handle->regs->USBINTR,
+	       handle->regs->USBMODE,
+	       portsc,
+	       USB_PORTSC1_CCS_GET(portsc),
+	       USB_PORTSC1_CSC_GET(portsc),
+	       USB_PORTSC1_PE_GET(portsc),
+	       USB_PORTSC1_PEC_GET(portsc),
+	       USB_PORTSC1_PR_GET(portsc),
+	       USB_PORTSC1_SUSP_GET(portsc),
+	       USB_PORTSC1_LS_GET(portsc),
+	       USB_PORTSC1_PFSC_GET(portsc),
+	       USB_PORTSC1_PSPD_GET(portsc),
+	       otgsc,
+	       USB_OTGSC_ASV_GET(otgsc),
+	       USB_OTGSC_AVV_GET(otgsc),
+	       USB_OTGSC_ID_GET(otgsc),
+	       USB_OTGSC_IDPU_GET(otgsc),
+	       USB_OTGSC_VC_GET(otgsc),
+	       USB_OTGSC_VD_GET(otgsc),
+	       handle->regs->DEVICEADDR,
+	       handle->regs->ENDPTLISTADDR,
+	       handle->regs->ENDPTSETUPSTAT,
+	       handle->regs->ENDPTPRIME,
+	       handle->regs->ENDPTFLUSH,
+	       handle->regs->ENDPTSTAT,
+	       handle->regs->ENDPTCOMPLETE,
+	       handle->regs->ENDPTCTRL[0],
+	       handle->regs->OTG_CTRL0,
+	       phy_status,
+	       USB_PHY_STATUS_UTMI_CLK_VALID_GET(phy_status),
+	       USB_PHY_STATUS_LINE_STATE_GET(phy_status),
+	       USB_PHY_STATUS_HOST_DISCONNECT_GET(phy_status),
+	       USB_PHY_STATUS_ID_DIG_GET(phy_status),
+	       USB_PHY_STATUS_UTMI_SESS_VALID_GET(phy_status),
+	       USB_PHY_STATUS_VBUS_VALID_GET(phy_status));
+}
+
+static void udc_hpm_dump_ep0_qhd(usb_device_handle_t *handle, const char *tag)
+{
+	dcd_qhd_t *qhd0 = usb_device_qhd_get(handle, 0);
+	dcd_qhd_t *qhd1 = usb_device_qhd_get(handle, 1);
+
+	USB_HPM_TRACE_PRINTK("usb:%s qhd0 local=%p sys=0x%x ios=%u mps=%u zlt=%u overlay_next=0x%x setup=%02x %02x %04x %04x %04x\n",
+	       tag,
+	       qhd0,
+	       udc_hpm_sys_addr(qhd0),
+	       qhd0->int_on_setup,
+	       qhd0->max_packet_size,
+	       qhd0->zero_length_termination,
+	       qhd0->qtd_overlay.next,
+	       qhd0->setup_request.bmRequestType,
+	       qhd0->setup_request.bRequest,
+	       qhd0->setup_request.wValue,
+	       qhd0->setup_request.wIndex,
+	       qhd0->setup_request.wLength);
+	USB_HPM_TRACE_PRINTK("usb:%s qhd1 local=%p sys=0x%x ios=%u mps=%u zlt=%u overlay_next=0x%x\n",
+	       tag,
+	       qhd1,
+	       udc_hpm_sys_addr(qhd1),
+	       qhd1->int_on_setup,
+	       qhd1->max_packet_size,
+	       qhd1->zero_length_termination,
+	       qhd1->qtd_overlay.next);
+}
